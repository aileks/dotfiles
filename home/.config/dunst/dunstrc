[global]
dmenu = dmenu -i -c -l 3 -p Notifications -S
follow = none
width = 380
height = (0, 120)
origin = top-right
offset = (3, 28)
frame_width = 2
frame_color = "#80756E"
separator_color = frame
font = Iosevka Nerd Font 12
icon_position = left
icon_theme = Papirus-Dark
max_icon_size = 32
gap_size = 6
padding = 10
horizontal_padding = 12
text_icon_padding = 10
corner_radius = 0
format = "<b>%s</b>\n%b"
timeout = 5

[urgency_low]
background = "#221B17"
foreground = "#DED6D0"
frame_color = "#80756E"
highlight = "#B39887"
timeout = 4

[urgency_normal]
background = "#221B17"
foreground = "#DED6D0"
frame_color = "#80756E"
highlight = "#B39887"
timeout = 5

[urgency_critical]
background = "#221B17"
foreground = "#DED6D0"
frame_color = "#E07972"
highlight = "#E07972"
timeout = 0

[volume]
appname = volume
format = "<b>%s</b> %b"

[brightness]
appname = brightness
format = "<b>%s</b> %b"
