#!/usr/bin/env bash

set -euo pipefail

[[ $EUID == 0 && $(findmnt -n -o FSTYPE --mountpoint /boot) == vfat ]] || {
  echo 'Run as root with the VFAT ESP mounted at /boot.' >&2
  exit 1
}

confirm=false
if [[ ${1:-} == --confirm-running ]]; then
  confirm=true
  version=$(uname -r)
  kernel=/boot/vmlinuz-$version
else
  version=${1:?kernel version required}
  kernel=${2:?kernel image required}
fi

[[ $version =~ ^[a-zA-Z0-9._+-]+$ ]] || exit 2
initramfs=/boot/initramfs-$version.img

[[ -s $kernel && -s $initramfs ]] || {
  echo "Missing kernel or matching initramfs for $version." >&2
  exit 1
}

root_device=$(findmnt --fstab --evaluate --noheadings --output SOURCE --mountpoint /)
root_type=$(findmnt --fstab --noheadings --output FSTYPE --mountpoint /)
[[ $root_type == ext4 || $root_type == xfs ]] || {
  echo 'This installer supports an unencrypted ext4 or XFS root partition.' >&2
  exit 1
}

[[ $(lsblk -dn -o TYPE "$root_device") == part ]] || {
  echo 'Encrypted, LVM and RAID root devices need a separate boot configuration.' >&2
  exit 1
}

root_uuid=$(blkid -s UUID -o value "$root_device")
[[ -n $root_uuid ]] || exit 1
cmdline="root=UUID=$root_uuid rw acpi_enforce_resources=lax nvidia_drm.modeset=1"

mapfile -t swap_devices < <(findmnt --fstab --evaluate --noheadings --types swap --output SOURCE)
if ((${#swap_devices[@]} == 1)) && [[ -b ${swap_devices[0]} ]]; then
  swap_uuid=$(blkid -s UUID -o value "${swap_devices[0]}")
  [[ -n $swap_uuid ]] || exit 1
  cmdline+=" resume=UUID=$swap_uuid"
fi

mkdir -p /boot/limine/kernels /boot/EFI/limine
temporary=$(mktemp -d /boot/limine/.update.XXXXXXXX)
trap 'rm -rf -- "$temporary"' EXIT

# Keep the previous config bootable until the final rename.
generation=$version-$(date +%s)-$$
mkdir "$temporary/$generation"
cp "$kernel" "$temporary/$generation/vmlinuz"
cp "$initramfs" "$temporary/$generation/initramfs.img"
sync -f "$temporary"
mv "$temporary/$generation" /boot/limine/kernels/

if "$confirm"; then
  printf '%s\n' "$generation" >"$temporary/known-good"
  mv "$temporary/known-good" /boot/limine/known-good
fi

entry() {
  local title=$1 selected=$2

  printf '\n/%s\n' "$title"
  printf '    protocol: linux\n'
  printf '    path: boot():/limine/kernels/%s/vmlinuz\n' "$selected"
  printf '    module_path: boot():/limine/kernels/%s/initramfs.img\n' "$selected"
  printf '    cmdline: %s\n' "$cmdline"
}

{
  printf 'timeout: 3\neditor_enabled: no\n'
  entry "Gentoo $version" "$generation"

  if [[ -f /boot/limine/known-good ]]; then
    read -r recovery </boot/limine/known-good
    [[ $recovery =~ ^[a-zA-Z0-9._+-]+$ ]]
    [[ -s /boot/limine/kernels/$recovery/vmlinuz && -s /boot/limine/kernels/$recovery/initramfs.img ]]
    entry 'Gentoo recovery' "$recovery"
  fi
} >"$temporary/limine.conf"

sync -f "$temporary/limine.conf"
mv "$temporary/limine.conf" /boot/EFI/limine/limine.conf
sync -f /boot

echo 'Limine configuration updated. Old kernel copies are retained.'
