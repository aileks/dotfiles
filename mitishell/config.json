{
  "version": 2,
  "bar": {
    "outputs": [
      "DP-1"
    ],
    "height": 34,
    "marginTop": 6,
    "marginHorizontal": 5,
    "systemMetrics": "separate",
    "layout": {
      "left": [
        "workspaces",
        "windowTitle"
      ],
      "center": [
        "weather",
        "media",
        "clock"
      ],
      "right": [
        "updates",
        "status",
        "system",
        "audio",
        "bluetooth",
        "notifications",
        "quickSettings",
        "tray",
        "power"
      ],
      "hidden": [
        "network",
        "keyboardLayout"
      ]
    }
  },
  "clock": {
    "format": "24h",
    "showDate": true,
    "timezones": null
  },
  "calendar": {
    "showWeekNumbers": false
  },
  "weather": {
    "enabled": true,
    "units": "auto",
    "location": ""
  },
  "motion": {
    "enabled": true,
    "reduced": false
  },
  "font": {
    "family": "Maple Mono Medium",
    "monoFamily": "Maple Mono NF",
    "size": 15,
    "monoSize": 15
  },
  "clipboard": {
    "enabled": true,
    "maxEntries": 15
  }
}
