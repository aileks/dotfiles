#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=dwm XDG_SESSION_DESKTOP=dwm
export XDG_DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
export LIBVA_DRIVER_NAME=nvidia NVD_BACKEND=direct __GLX_VENDOR_LIBRARY_NAME=nvidia
export ELECTRON_OZONE_PLATFORM_HINT=x11
export QT_QPA_PLATFORMTHEME=qt6ct
export EDITOR=nvim VISUAL=nvim
export BEMOJI_PICKER_CMD="dmenu -i -p Emoji" BEMOJI_CLIP_CMD=xclip
export CM_LAUNCHER=dmenu CM_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/clipmenu"

# setxkbmap only resolves layouts registered in the xkb rules; fall back to
# loading the symbols file directly.
setxkbmap aileks || xkbcomp -I"${XDG_CONFIG_HOME:-$HOME/.config}/xkb" \
  "${XDG_CONFIG_HOME:-$HOME/.config}/xkb/symbols/aileks" "${DISPLAY:-:0}"

# Match the mango session: repeat_delay 250 ms, repeat_rate 50 cps.
xset r rate 250 50

# dbus-run-session creates a real bus and keeps it alive until dwm exits;
# dwm's autostart patch launches the desktop processes after it starts.
exec dbus-run-session -- dwm
