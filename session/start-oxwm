#!/usr/bin/env bash
set -euo pipefail

export NPM_CONFIG_PREFIX="$HOME/.local"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_CURRENT_DESKTOP=oxwm XDG_SESSION_DESKTOP=oxwm XDG_SESSION_TYPE=x11
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
export LIBVA_DRIVER_NAME=nvidia NVD_BACKEND=direct __GLX_VENDOR_LIBRARY_NAME=nvidia
export MOZ_ENABLE_WAYLAND=1 MOZE_DISABLE_RDD_SANDBOX=1
export QT_QPA_PLATFORMTHEME=qt6ct
export EDITOR=nvim VISUAL=nvim
export BEMOJI_PICKER_CMD='rofi -dmenu -i -p Emoji' BEMOJI_CLIP_CMD=xclip
export CM_LAUNCHER=rofi CM_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}/clipmenu"
export CM_MAX_CLIPS=20

setxkbmap aileks || setxkbmap -symbols aileks || printf 'warning: failed to load the aileks keyboard layout\n' >&2

xset r rate 250 50

exec dbus-run-session -- oxwm
