#!/usr/bin/env bash

set -Eeuo pipefail

if [[ ${1:-} == --status || ${1:-} == --click ]]; then
  source "${XDG_CONFIG_HOME:-$HOME/.config}/dwl/status.conf"

  update_block() {
    local index=$1 value
    value=$(timeout --foreground -k 1 3 "${commands[index]}" </dev/null 2>/dev/null | head -c 4096) || value=n/a
    # Leave room for multi-byte glyphs in the bar's 160-byte text buffer.
    value=${value//[[:cntrl:]]/ }
    printf '%s' "${value:0:39}" >"${DWL_SESSION_DIR:?}/block.$index.$BASHPID"
    mv "$DWL_SESSION_DIR/block.$index.$BASHPID" "$DWL_SESSION_DIR/block.$index"
  }

  if [[ $1 == --click ]]; then
    [[ $# == 3 && $2 =~ ^[0-9]$ && $3 =~ ^[1-5]$ ]] || exit 2
    (($2 < ${#commands[@]})) || exit 2
    export BLOCK_BUTTON=$3
    update_block "$2"
    exit
  fi

  workers=()
  trap 'kill "${workers[@]}" 2>/dev/null || true; wait || true' EXIT
  trap 'exit 0' TERM INT HUP PIPE
  while [[ ! -e ${DWL_SESSION_DIR:?}/ready ]]; do sleep 0.1; done
  for index in "${!commands[@]}"; do
    (
      trap - EXIT
      while :; do
        update_block "$index"
        printf -v now '%(%s)T' -1
        sleep "$((intervals[index] - now % intervals[index]))"
      done
    ) &
    workers+=("$!")
  done

  while :; do
    separator=
    for index in "${!commands[@]}"; do
      value=
      [[ ! -f $DWL_SESSION_DIR/block.$index ]] || value=$(<"$DWL_SESSION_DIR/block.$index")
      printf '%s%s %s' "$separator" "${colors[index]}" "$value"
      separator=$'\t'
    done
    printf '\n'
    sleep 1
  done
fi

export NPM_CONFIG_PREFIX="$HOME/.local"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_CURRENT_DESKTOP=dwl XDG_SESSION_DESKTOP=dwl XDG_SESSION_TYPE=wayland
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24 XCURSOR_PATH=/usr/share/icons
export LIBVA_DRIVER_NAME=nvidia NVD_BACKEND=direct
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORMTHEME=qt6ct
export EDITOR=nvim VISUAL=nvim
export BEMOJI_PICKER_CMD='rofi -dmenu -i -p Emoji' BEMOJI_CLIP_CMD=wl-copy
export CLIPHIST_MAX_ITEMS=20 CLIPHIST_DB_PATH="${XDG_RUNTIME_DIR:?}/cliphist/db"
export LIBSEAT_BACKEND=logind

if [[ ${1:-} != --session ]]; then
  unset DISPLAY WAYLAND_DISPLAY XAUTHORITY DWL_CAPTURE_CONTEXT
  exec dbus-run-session -- "$0" --session
fi

umask 077
export DWL_SESSION_DIR
DWL_SESSION_DIR=$(mktemp -d "$XDG_RUNTIME_DIR/dwl.XXXXXXXX")
mkdir -p "${CLIPHIST_DB_PATH%/*}"
mkfifo "$DWL_SESSION_DIR/status"
status_pid=
dwl_pid=

# Invoked by the EXIT trap.
cleanup() {
  trap - EXIT TERM INT HUP
  [[ -z $dwl_pid ]] || kill -TERM "$dwl_pid" 2>/dev/null || true
  [[ -z $status_pid ]] || kill -TERM -- "-$status_pid" 2>/dev/null || true
  wait 2>/dev/null || true
  rm -rf -- "$DWL_SESSION_DIR"
}
trap cleanup EXIT
trap 'exit 130' TERM INT HUP

while :; do
  rm -f -- "$DWL_SESSION_DIR/ready"
  setsid "$0" --status >"$DWL_SESSION_DIR/status" &
  status_pid=$!
  /usr/local/bin/dwl <"$DWL_SESSION_DIR/status" &
  dwl_pid=$!
  result=0
  wait "$dwl_pid" || result=$?
  dwl_pid=
  kill -TERM -- "-$status_pid" 2>/dev/null || true
  wait "$status_pid" 2>/dev/null || true
  status_pid=
  # dwl exits with 75 only for Super+Shift+R.
  ((result == 75)) || exit "$result"
done
