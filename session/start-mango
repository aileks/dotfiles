#!/usr/bin/env bash
set -euo pipefail

case ${1:-mango} in
  mango | /usr/bin/mango) (($# == 0)) || shift ;;
  *) exec "$@" ;;
esac

export PATH="$HOME/.local/bin:$PATH"
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=mango XDG_SESSION_DESKTOP=mango
export XDG_DATA_DIRS="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XKB_CONFIG_EXTRA_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/xkb"
export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"

exec dbus-run-session -- mango "$@"
