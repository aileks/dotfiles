#!/bin/sh

set -eu

version=${1:?kernel version required}
kernel=${2:?kernel image required}
case "$version" in *[!a-zA-Z0-9._+-]* | '') exit 2 ;; esac
boot=$(dirname "$kernel")
[ "$boot" = /boot ] || {
  echo 'Expected kernel in /boot' >&2
  exit 1
}

[ "$(findmnt -n -o FSTYPE --mountpoint /boot)" = vfat ] || {
  echo '/boot must be the mounted VFAT ESP' >&2
  exit 1
}

# Gentoo installkernel's non-UKI layout installs this version-matched name.
initramfs="$boot/initramfs-$version.img"
[ -s "$kernel" ] && [ -s "$initramfs" ] || {
  echo "Missing kernel or matching initramfs for $version" >&2
  exit 1
}

temporary=$(mktemp -d "$boot/.limine-copy.XXXXXX")
trap 'rm -rf "$temporary"' EXIT
cp "$kernel" "$temporary/vmlinuz-gentoo"
cp "$initramfs" "$temporary/initramfs-gentoo.img"
sync "$temporary/vmlinuz-gentoo" "$temporary/initramfs-gentoo.img"
mv -f "$temporary/initramfs-gentoo.img" "$boot/initramfs-gentoo.img"
mv -f "$temporary/vmlinuz-gentoo" "$boot/vmlinuz-gentoo"
sync "$boot"
