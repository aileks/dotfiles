--- a/clipmenud
+++ b/clipmenud
@@ -141,3 +141,7 @@
         _CM_CLIPNOTIFY_PID="$!"
-        wait "$_CM_CLIPNOTIFY_PID"
+        wait "$_CM_CLIPNOTIFY_PID" || {
+            # clipctl signals interrupt wait with a status above 128.
