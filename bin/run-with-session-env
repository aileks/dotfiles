#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
[[ -d ${XDG_RUNTIME_DIR:-} ]] || exit 0
# shellcheck source=config/session/processes.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/session/processes.sh"
session_is_live || exit 0
[[ -f $RUNTIME_DIR/session.env && ! -L $RUNTIME_DIR/session.env && -O $RUNTIME_DIR/session.env && $(stat -c %a "$RUNTIME_DIR/session.env") == 600 ]] || exit 0
# shellcheck source=/dev/null
source "$RUNTIME_DIR/session.env"
exec "$@"
