#!/usr/bin/env bash

set -Eeuo pipefail

freeze_pid=''

cleanup() {
  if [[ -n $freeze_pid ]]; then
    kill "$freeze_pid" 2>/dev/null || true
    wait "$freeze_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

hyprpicker -r -z >/dev/null 2>&1 &
freeze_pid=$!
sleep 0.1
geometry=$(slurp) || exit 0

if ! result=$(grim -g "$geometry" - | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null) \
  || [[ -z $result ]]; then
  notify-send -u critical -a 'QR Capture' 'No QR code found'
  exit 1
fi

printf '%s' "$result" | wl-copy --sensitive
notify-send -a 'QR Capture' 'QR code copied'
