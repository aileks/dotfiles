#!/usr/bin/env bash

set -Eeuo pipefail

directory="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
file="$directory/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$directory"

case "${1:-}" in
  output)
    grim "$file"
    ;;
  region)
    geometry=$(slurp) || exit 0
    grim -g "$geometry" "$file"
    ;;
  window)
    geometry=$(hyprctl -j activewindow | jq -er \
      '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    grim -g "$geometry" "$file"
    ;;
  *) exit 2 ;;
esac

wl-copy <"$file"

if [[ $(notify-send -a Screenshot -i "$file" -A annotate=Annotate \
  'Screenshot saved' "$file") == annotate ]]; then
  satty \
    --filename "$file" \
    --output-filename "$file" \
    --copy-command wl-copy \
    --app-id org.satty.satty \
    --actions-on-enter save-to-file \
    --actions-on-enter save-to-clipboard \
    --actions-on-enter exit \
    --actions-on-right-click save-to-file \
    --actions-on-right-click save-to-clipboard \
    --actions-on-right-click exit
fi
