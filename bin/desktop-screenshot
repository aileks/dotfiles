#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'usage: desktop-screenshot <region|window|output|desktop> [--copy] [--save]\n' >&2
}

mode=${1:-}
shift || true
case "$mode" in
  region|window|output|desktop) ;;
  *)
    usage
    exit 2
    ;;
esac

copy=1
save=1
if (($#)); then
  copy=0
  save=0
  for option in "$@"; do
    case "$option" in
      --copy) copy=1 ;;
      --save) save=1 ;;
      *)
        usage
        exit 2
        ;;
    esac
  done
fi

((copy || save)) || {
  usage
  exit 2
}

freeze_pid=''
temporary_file=''
cleanup() {
  if [[ -n $freeze_pid ]]; then
    kill "$freeze_pid" 2>/dev/null || true
    wait "$freeze_pid" 2>/dev/null || true
  fi
  [[ -z $temporary_file ]] || rm -f "$temporary_file"
}
trap cleanup EXIT

if ((save)); then
  pictures_directory=$(xdg-user-dir PICTURES 2>/dev/null || true)
  directory="${pictures_directory:-${XDG_PICTURES_DIR:-$HOME/Pictures}}/Screenshots"
  mkdir -p "$directory"
  file="$directory/$(date +%Y-%m-%d_%H-%M-%S).png"
else
  temporary_file=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/desktop-screenshot.XXXXXX.png")
  file=$temporary_file
fi

case "$mode" in
  output)
    focused_output=$(hyprctl -j monitors | jq -er '.[] | select(.focused) | .name') || {
      notify-send -u critical -a Screenshot 'Screenshot failed' \
        'Could not determine the focused output.'
      exit 1
    }
    grim -o "$focused_output" "$file"
    ;;
  desktop)
    grim "$file"
    ;;
  region)
    hyprpicker -r -z >/dev/null 2>&1 &
    freeze_pid=$!
    sleep 0.1
    geometry=$(slurp) || exit 0
    grim -g "$geometry" "$file"
    kill "$freeze_pid" 2>/dev/null || true
    wait "$freeze_pid" 2>/dev/null || true
    freeze_pid=''
    ;;
  window)
    geometry=$(hyprctl -j activewindow | jq -er \
      '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    grim -g "$geometry" "$file"
    ;;
esac

((copy)) && wl-copy <"$file"

if ((save)); then
  title='Screenshot saved'
  ((copy)) && title='Screenshot saved and copied'
  if [[ $(notify-send -a Screenshot -i "$file" -A annotate=Annotate \
    "$title" "$file") == annotate ]]; then
    tensaku \
      --filename "$file" \
      --output-filename "$file" \
      --copy-command wl-copy \
      --app-id dev.tensaku.Tensaku \
      --actions-on-enter save-to-file \
      --actions-on-enter save-to-clipboard \
      --actions-on-enter exit
  fi
else
  notify-send -a Screenshot 'Screenshot copied'
fi
