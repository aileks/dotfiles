#!/usr/bin/env bash

# @vicinae.schemaVersion 1
# @vicinae.title Set Reminder
# @vicinae.mode silent
# @vicinae.argument1 { "type": "text", "placeholder": "Minutes" }
# @vicinae.argument2 { "type": "text", "placeholder": "Message", "optional": true }

set -Eeuo pipefail

readonly runtime_directory="${XDG_RUNTIME_DIR:-/run/user/$UID}/desktop-reminders"
umask 077

refresh_waybar() {
  pkill -RTMIN+9 -x waybar 2>/dev/null || true
}

message_file() {
  printf '%s/%s' "$runtime_directory" "$1"
}

active_timers() {
  local timers
  timers=$(systemctl --user list-timers --all --output=json \
    'desktop-reminder-*.timer' 2>/dev/null || true)
  [[ -n $timers ]] || timers='[]'
  jq -r '.[] | [.unit, .next] | @tsv' <<<"$timers"
}

remaining_time() {
  local seconds
  seconds=$(($1 / 1000000 - $(date +%s)))
  ((seconds > 0)) || seconds=0
  if ((seconds >= 3600)); then
    printf '%dh %dm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
  elif ((seconds >= 60)); then
    printf '%dm' "$((seconds / 60))"
  else
    printf '%ds' "$seconds"
  fi
}

show_reminders() {
  local count=0 unit next title body file
  while IFS=$'\t' read -r unit next; do
    [[ -n $unit && $next =~ ^[0-9]+$ ]] || continue
    unit=${unit%.timer}
    title="Reminder in $(remaining_time "$next")"
    file=$(message_file "$unit")
    if [[ -r $file ]]; then
      body=$(<"$file")
    else
      body=Reminder
    fi
    body+=" at $(date --date="@$((next / 1000000))" +'%H:%M')"
    notify-send -a Reminder "$title" "$body"
    ((count += 1))
  done < <(active_timers)
  if ((count == 0)); then
    notify-send -a Reminder 'No active reminders'
  fi
}

clear_reminders() {
  local count=0 unit next
  while IFS=$'\t' read -r unit next; do
    [[ -n $unit ]] || continue
    systemctl --user stop "$unit" "${unit%.timer}.service" 2>/dev/null || true
    rm -f "$(message_file "${unit%.timer}")"
    ((count += 1))
  done < <(active_timers)
  refresh_waybar
  notify-send -a Reminder "Cleared $count reminder(s)"
}

reminder_status() {
  local count
  count=$(active_timers | awk 'NF { count++ } END { print count + 0 }')
  printf '%s\n' "$count"
  ((count > 0))
}

fire_reminder() {
  local unit="$1" file message
  [[ $unit =~ ^desktop-reminder-[a-zA-Z0-9_-]+$ ]] || exit 2
  file=$(message_file "$unit")
  if [[ -r $file ]]; then
    message=$(<"$file")
  else
    message=Reminder
  fi
  notify-send -u critical -a Reminder 'Reminder' "$message"
  rm -f "$file"
  refresh_waybar
}

create_reminder() {
  local minutes="$1" message="${2:-}" unit file
  [[ $minutes =~ ^[1-9][0-9]*$ ]] || {
    notify-send -u critical -a Reminder 'Invalid reminder' 'Minutes must be a positive integer.'
    exit 2
  }
  [[ -n $message ]] || message="Your $minutes minutes are up"
  unit="desktop-reminder-${minutes}m-$(date +%s%N)"
  mkdir -p "$runtime_directory"
  file=$(message_file "$unit")
  printf '%s\n' "$message" >"$file"
  if ! systemd-run --user --quiet --collect --on-active="${minutes}m" \
    --unit="$unit" "$HOME/.local/bin/desktop-reminder" fire "$unit"; then
    rm -f "$file"
    notify-send -u critical -a Reminder 'Could not set reminder'
    exit 1
  fi
  refresh_waybar
  notify-send -a Reminder "Reminder set for $minutes minute(s)"
}

case "${1:-}" in
  show) show_reminders ;;
  clear) clear_reminders ;;
  status) reminder_status ;;
  fire)
    [[ $# == 2 ]] || exit 2
    fire_reminder "$2"
    ;;
  '')
    printf 'usage: desktop-reminder <minutes> [message] | show | clear | status\n' >&2
    exit 2
    ;;
  *)
    message=${*:2}
    create_reminder "$1" "$message"
    ;;
esac
