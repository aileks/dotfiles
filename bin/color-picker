#!/usr/bin/env bash

set -euo pipefail

geometry=$(slurp -p </dev/null) || exit 0
pixel=$(grim -s 1 -g "$geometry" - | ffmpeg -loglevel error -i pipe:0 -f rawvideo -pix_fmt rgb24 - 2>/dev/null | od -An -tu1)
read -r red green blue <<<"$pixel"
printf -v color '#%02X%02X%02X' "$red" "$green" "$blue"
wl-copy <<<"$color"
printf '%s\n' "$color"
