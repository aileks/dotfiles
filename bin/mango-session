#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=config/session/processes.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/session/processes.sh"

exec 9>"$RUNTIME_DIR/session.lock"
flock -n 9 || {
  echo 'A Mango session is already running' >&2
  exit 1
}

cleanup() {
  trap - EXIT
  trap '' TERM INT HUP
  touch "$RUNTIME_DIR/stopping"
  rm -f "$RUNTIME_DIR/session.env" "$RUNTIME_DIR/session.owner"
  # Private clipboard must stop before the history watcher; stopping prevents
  # its cleanup from restarting capture during logout.
  stop_session_process private-clipboard
  for record in "$RUNTIME_DIR/"*.pid; do
    [[ -f $record ]] || continue
    name=${record##*/}
    stop_session_process "${name%.pid}"
  done
}

trap cleanup EXIT
trap 'exit 0' TERM INT HUP

# Reap anything this configuration left after an interrupted session.
cleanup
trap cleanup EXIT
rm -f "$RUNTIME_DIR/stopping"
trap 'exit 0' TERM INT HUP
printf '%s %s\n' "$$" "$(process_start "$$")" >"$RUNTIME_DIR/session.owner"

if (($# == 0)); then
  set -- mango
fi

"$@" 9>&- &
mango_pid=$!
printf '%s %s\n' "$mango_pid" "$(process_start "$mango_pid")" >"$RUNTIME_DIR/mango.pid"
wait "$mango_pid"
