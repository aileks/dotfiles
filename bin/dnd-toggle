#!/usr/bin/env bash

set -Eeuo pipefail

if ! pause_level=$(dunstctl get-pause-level); then
  desktop-feedback status 'Do not disturb state unavailable' || true
  exit 1
fi

if ((pause_level > 0)); then
  level=0
  state=off
else
  level=90
  state=on
fi
if ! dunstctl set-pause-level "$level"; then
  desktop-feedback status 'Do not disturb change failed' || true
  exit 1
fi
desktop-feedback status "Do not disturb $state" || true
