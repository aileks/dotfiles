#!/usr/bin/env bash

state="${XDG_RUNTIME_DIR:-/run/user/$UID}/bar-clock-format"

[[ ${BLOCK_BUTTON:-} == 1 ]] && {
  if [[ -e $state ]]; then
    rm -f -- "$state" || exit 1
  else
    touch -- "$state" || exit 1
  fi
  pkill -RTMIN+5 dwmblocks >/dev/null 2>&1 || true
}

if [[ -e $state ]]; then
  format='%a %d %b %I:%M %p'
else
  format='%a %d %b %H:%M'
fi

printf -v current_time "%($format)T" -1
printf '^c#DDD5CA^%s %s^d^\n' '' "$current_time"
