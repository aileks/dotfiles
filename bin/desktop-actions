#!/usr/bin/env bash

set -Eeuo pipefail

readonly local_bin="$HOME/.local/bin/"

choose() {
  walker --dmenu --placeholder "$1"
}

nightlight_label='Enable Night Light'
if mitishell night-light status 2>/dev/null | grep -q '^on '; then
  nightlight_label='Disable Night Light'
fi

recording_actions=$'Record Region\nRecord Output'
if "$local_bin"desktop-record status >/dev/null 2>&1; then
  recording_actions='Stop Recording'
fi

choice=$(printf '%s\n' \
  'Toggle Do Not Disturb' \
  "$nightlight_label" \
  'Set Reminder' \
  'View Reminders' \
  'Clear Reminders' \
  'Screenshot Region' \
  'Screenshot Window' \
  'Screenshot Output' \
  'Screenshot Desktop' \
  'Extract Text' \
  'Scan QR Code' \
  'Power Profile' \
  'Firmware Updates' \
  "$recording_actions" | choose 'Desktop action') || exit 0

case "$choice" in
  *'Do Not Disturb') mitishell notifications dnd ;;
  *'Night Light') mitishell night-light toggle ;;
  'Set Reminder') mitishell reminder ;;
  'View Reminders') mitishell reminder list ;;
  'Clear Reminders') mitishell reminder clear ;;
  'Screenshot Region') "$local_bin"desktop-screenshot region ;;
  'Screenshot Window') "$local_bin"desktop-screenshot window ;;
  'Screenshot Output') "$local_bin"desktop-screenshot output ;;
  'Screenshot Desktop') "$local_bin"desktop-screenshot desktop ;;
  'Extract Text') "$local_bin"desktop-ocr ;;
  'Scan QR Code') "$local_bin"desktop-qr ;;
  'Stop Recording') "$local_bin"desktop-record stop ;;
  'Power Profile')
    active_profile=$(powerprofilesctl get)
    profile=$(powerprofilesctl list | sed -n 's/^[ *]*\([^:]*\):$/\1/p' \
      | awk -v active="$active_profile" '{ print ($0 == active ? "* " : "  ") $0 }' \
      | choose "Power profile: $active_profile") || exit 0
    profile=${profile#\* }
    profile=${profile#  }
    [[ -z $profile || $profile == "$active_profile" ]] || powerprofilesctl set "$profile"
    ;;
  'Firmware Updates')
    uwsm app -- alacritty --hold -e bash -lc 'fwupdmgr refresh && fwupdmgr update'
    ;;
  'Record Region' | 'Record Output')
    mode=${choice#Record }
    "$local_bin"desktop-record "${mode,,}"
    ;;
esac
