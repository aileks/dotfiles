#!/usr/bin/env bash
set -euo pipefail
case ${1:-toggle} in
  toggle)
    if pgrep -u "$UID" -x gammastep >/dev/null; then
      pkill -USR1 -u "$UID" -x gammastep
    else
      gammastep -c /dev/null -m randr -l 0:0 -t 4800:4800 -r &
    fi
    ;;
  *)
    echo 'Usage: night-light [toggle]' >&2
    exit 2
    ;;
esac
