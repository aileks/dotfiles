#!/usr/bin/env bash

set -Eeuo pipefail

hyprctl -j binds | jq -r '
  def modifiers:
    [
      if (.modmask / 64 | floor) % 2 == 1 then "Super" else empty end,
      if (.modmask / 8 | floor) % 2 == 1 then "Alt" else empty end,
      if (.modmask / 4 | floor) % 2 == 1 then "Ctrl" else empty end,
      if .modmask % 2 == 1 then "Shift" else empty end
    ];
  map(select(.description != ""))
  | unique_by([.modmask, .key, .description])
  | sort_by(.description)
  | .[]
  | ((modifiers + [.key]) | join(" + ")) + "\t" + .description
' | walker --dmenu --placeholder 'Search keybinds' >/dev/null || exit 0
