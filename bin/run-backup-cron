#!/usr/bin/env bash

set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
if [[ -d ${XDG_RUNTIME_DIR:-} ]]; then
  # shellcheck source=config/session/processes.sh
  source "${XDG_CONFIG_HOME:-$HOME/.config}/session/processes.sh"
  if session_is_live && [[ -f $RUNTIME_DIR/session.env && ! -L $RUNTIME_DIR/session.env && -O $RUNTIME_DIR/session.env && $(stat -c %a "$RUNTIME_DIR/session.env") == 600 ]]; then
    # shellcheck source=/dev/null
    source "$RUNTIME_DIR/session.env"
  fi
fi

exec home-backup
