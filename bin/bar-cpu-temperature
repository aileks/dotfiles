#!/usr/bin/env bash

[[ ${BLOCK_BUTTON:-} == 1 ]] && wezterm start --always-new-process -- btop >/dev/null 2>&1 &

read -r _ user nice system idle _ </proc/stat
busy1=$((user + nice + system))
total1=$((busy1 + idle))
sleep 0.25
read -r _ user nice system idle _ </proc/stat
busy2=$((user + nice + system))
total2=$((busy2 + idle))
usage=0
if ((total2 > total1)); then
  usage=$((100 * (busy2 - busy1) / (total2 - total1)))
fi

temp=""
for d in /sys/class/hwmon/hwmon*; do
  if [[ "$(cat "$d/name" 2>/dev/null)" == k10temp ]]; then
    inputs=()
    fallback="$d/temp1_input"
    for label in "$d"/temp*_label; do
      [[ -r $label ]] || continue
      input="${label%_label}_input"
      [[ -r $input ]] || continue
      case "$(cat "$label")" in
        Tccd*) inputs+=("$input") ;;
        Tdie) fallback="$input" ;;
      esac
    done
    if ((${#inputs[@]} == 0)) && [[ -r $fallback ]]; then
      inputs+=("$fallback")
    fi
    if ((${#inputs[@]} > 0)); then
      temp=$(awk '{ sum += $1 } END { if (NR) printf "%.0f", sum / NR / 1000 }' "${inputs[@]}")
    fi
    break
  fi
done

printf '^c#E17A3F^\uF2DB  %s%% %s°C^d^\n' "$usage" "${temp:-n/a}"
