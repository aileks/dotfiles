#!/usr/bin/env bash

case ${BLOCK_BUTTON:-} in
  1) dnd-toggle >/dev/null 2>&1 & ;;
  2) dunstctl history-clear >/dev/null 2>&1 & ;;
  3) notification-history >/dev/null 2>&1 & ;;
esac

if ! pause_level=$(dunstctl get-pause-level 2>/dev/null); then
  printf '^c#58534C^󰂜^d^\n'
  exit 0
fi

if ((pause_level > 0)); then
  printf '^c#58534C^󰂛^d^\n'
else
  printf '^c#D9A441^󰂚^d^\n'
fi
