#!/usr/bin/env bash

set -euo pipefail

choice=$(printf '%s\n' 'log out' 'suspend' 'reboot' 'shut down' | rofi -dmenu -p Power) || exit 0
case "$choice" in
  # Let ly stop Xorg and restore the console after the window manager exits.
  'log out') pkill -TERM -u "$UID" -x oxwm ;;
  'suspend')
    pgrep -u "$UID" -x xss-lock >/dev/null || {
      desktop-feedback status 'Cannot suspend: automatic screen locking is not running'
      exit 1
    }
    loginctl suspend
    ;;
  'reboot') loginctl reboot ;;
  'shut down') loginctl poweroff ;;
esac
