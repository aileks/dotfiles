#!/usr/bin/env bash

set -eeuo pipefail

selection=$(printf '%s\n' lock logout suspend reboot shutdown |
	vicinae dmenu --navigation-title='Power' --placeholder='Choose an action' \
		--no-section --no-quick-look --no-footer) || exit 0
[[ -n $selection ]] || exit 0

case "$selection" in
lock)
	exec loginctl lock-session
	;;
logout)
	command=(uwsm stop)
	;;
suspend)
	command=(systemctl suspend)
	;;
reboot)
	command=(systemctl reboot)
	;;
shutdown)
	command=(systemctl poweroff)
	;;
*) exit 0 ;;
esac

confirmation=$(printf '%s\n' no yes |
	vicinae dmenu --navigation-title="Confirm $selection" --placeholder='Are you sure?' \
		--no-section --no-quick-look --no-footer) || exit 0
[[ $confirmation == yes ]] || exit 0
exec "${command[@]}"
