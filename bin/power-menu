#!/usr/bin/env bash

set -euo pipefail

choice=$(printf '%s\n' 'log out' 'suspend' 'reboot' 'shut down' | rofi -dmenu -p Power) || exit 0
case "$choice" in
  'log out') pkill -TERM -u "$UID" -x dwl ;;
  'suspend')
    lock-session || {
      desktop-feedback status 'Cannot suspend: screen locking failed'
      exit 1
    }
    loginctl suspend
    ;;
  'reboot') loginctl reboot ;;
  'shut down') loginctl poweroff ;;
esac
