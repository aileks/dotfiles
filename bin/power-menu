#!/usr/bin/env bash

set -euo pipefail

choice=$(printf '%s\n' 'log out' 'suspend' 'reboot' 'shut down' | rofi -dmenu -p Power) || exit 0
case "$choice" in
  'log out') pkill -x oxwm ;;
  'suspend')
    lock-session || {
      notify-send -u critical 'Cannot suspend: screen locking failed' || true
      exit 1
    }
    loginctl suspend
    ;;
  'reboot') loginctl reboot ;;
  'shut down') loginctl poweroff ;;
esac
