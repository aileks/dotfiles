#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

mode=${1:-}
case "$mode" in
  region | window | full) ;;
  *)
    printf 'usage: screenshot <region|window|full>\n' >&2
    exit 2
    ;;
esac

pictures_directory=$(xdg-user-dir PICTURES 2>/dev/null || true)
directory="${pictures_directory:-${XDG_PICTURES_DIR:-$HOME/Pictures}}/Screenshots"
mkdir -p "$directory"
file="$directory/$(date +%Y-%m-%d_%H-%M-%S-%N).png"

case "$mode" in
  region)
    geometry=$(slurp </dev/null) || exit 0
    [[ -n $geometry ]] || exit 0
    args=(-g "$geometry")
    ;;
  window)
    # Mango reports global logical geometry, including XWayland; grim handles scaling.
    if ! geometry=$(timeout 3 mmsg get focusing-client | jq -er '
      select(.id != null and .is_visible == true) |
      select([.x, .y, .width, .height] | all(type == "number" and floor == .)) |
      select(.width > 0 and .height > 0) |
      "\(.x),\(.y) \(.width)x\(.height)"
    '); then
      notify-send -u critical 'Screenshot failed' 'No focused window geometry available.' || true
      exit 1
    fi
    args=(-g "$geometry")
    ;;
  full) args=() ;;
esac

if ! grim "${args[@]}" "$file"; then
  rm -f -- "$file"
  notify-send -u critical -a Screenshot 'Screenshot failed' 'Could not capture the selected area.' || true
  exit 1
fi

if ! wl-copy --type image/png <"$file"; then
  notify-send -u critical -a Screenshot 'Screenshot saved' 'Could not copy the screenshot to the clipboard.' || true
  exit 1
fi

notify-send -a Screenshot -i "$file" 'Screenshot saved and copied' "$file" || true
