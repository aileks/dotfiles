#!/usr/bin/env bash

playing=$'\uF04B'
paused=$'\uF04C'
stopped=$'\uF04D'

[[ ${BLOCK_BUTTON:-} == 1 ]] && playerctl play-pause >/dev/null 2>&1

case $(playerctl status 2>/dev/null) in
  Playing) icon=$playing ;;
  Paused) icon=$paused ;;
  Stopped) icon=$stopped ;;
  *) icon=$stopped ;;
esac

if [[ $icon == "$stopped" ]]; then
  printf '%s\n' "$icon"
  exit 0
fi

metadata=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null)
[[ -n $metadata ]] || metadata=$(playerctl metadata --format '{{title}}' 2>/dev/null)
[[ -n $metadata ]] || exit 0
printf '%s %s\n' "$icon" "${metadata:0:44}"
