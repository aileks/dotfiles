#!/usr/bin/env bash
set -euo pipefail
umask 077
[[ ${1:-} == put && $# == 1 ]] || {
  echo 'Usage: private-clipboard put' >&2
  exit 2
}
exec 9>"${XDG_RUNTIME_DIR:?}/private-clipboard.lock"
flock -n 9 || {
  desktop-feedback status 'Private clipboard is in use'
  exit 1
}
payload=$(mktemp "$XDG_RUNTIME_DIR/private-clipboard.XXXXXXXX")
owner=
ready=false
cleanup() {
  rm -f -- "$payload"
  if ! "$ready" && [[ -n $owner ]]; then
    kill "$owner" 2>/dev/null || true
    wait "$owner" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
cat >"$payload"
[[ -s $payload ]] || exit 1
timeout 60s wl-copy --foreground --sensitive --type 'text/plain;charset=utf-8' \
  <"$payload" >/dev/null 2>&1 &
owner=$!
for _ in {1..20}; do
  kill -0 "$owner" 2>/dev/null || break
  if timeout 0.2s wl-paste --no-newline 2>/dev/null | cmp -s - "$payload"; then
    ready=true
    break
  fi
  sleep 0.05
done
"$ready" || {
  desktop-feedback status 'Private clipboard failed'
  exit 1
}
desktop-feedback status 'Copied privately for up to 60 seconds' || true
