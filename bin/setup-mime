#!/usr/bin/env bash

set -euo pipefail

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
repo=$(cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)

directories=(
  "$data_home/applications"
  "$data_home/flatpak/exports/share/applications"
  /var/lib/flatpak/exports/share/applications
  /usr/local/share/applications
  /usr/share/applications
)

declare -A installed=() resolved=() missing=()
shopt -s nullglob

for directory in "${directories[@]}"; do
  for desktop in "$directory/"*.desktop; do
    installed[${desktop##*/}]=$desktop
  done
done

matches=()
for name in "${!installed[@]}"; do
  executable=$(awk '
    /^\[/ { entry = ($0 ~ /^\[Desktop Entry\][[:space:]]*$/) }
    entry && /^[[:space:]]*Exec[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, ""); executable = $1
    }
    END { print executable }
  ' "${installed[$name]}")
  if [[ $executable == qutebrowser || $executable == */qutebrowser ]]; then
    matches+=("$name")
  fi
done

if ((${#matches[@]} != 1)); then
  echo 'Expected exactly one installed qutebrowser desktop entry; review installed applications' >&2
  exit 1
fi

browser=${matches[0]}
policy=$(jq -er 'to_entries[] | [.key, .value[0]] | @tsv' "$repo/config/xdg/mime-policy.json")

while IFS=$'\t' read -r mime name; do
  [[ $name == qutebrowser ]] && name=$browser
  if [[ $name == org.pwmt.zathura-* && ! -v installed[$name] ]]; then
    name=org.pwmt.zathura.desktop
  fi
  [[ -v installed[$name] ]] || missing[$name]=1
  resolved[$mime]=$name
done <<<"$policy"

if ((${#missing[@]})); then
  echo 'Install or resolve these desktop IDs first:' >&2
  printf '  %s\n' "${!missing[@]}" | sort >&2
  exit 1
fi

mkdir -p -- "$config_home"
temporary=$(mktemp -d "$config_home/.setup-mime.XXXXXXXX")
trap 'rm -f -- "$temporary/defaults" "$temporary/mimeapps.list"; rmdir -- "$temporary"' EXIT

for mime in "${!resolved[@]}"; do
  printf '%s=%s;\n' "$mime" "${resolved[$mime]}"
done | sort >"$temporary/defaults"

target=$config_home/mimeapps.list
existing=/dev/null
[[ -f $target ]] && existing=$target

# Merge only the managed defaults, retaining unrelated entries and sections.
awk '
  function remaining( key) {
    for (key in defaults)
      if (!written[key]++) print key "=" defaults[key]
  }
  FILENAME == ARGV[1] {
    key = substr($0, 1, index($0, "=") - 1)
    defaults[key] = substr($0, index($0, "=") + 1)
    next
  }
  /^\[/ {
    if (section) remaining()
    section = ($0 ~ /^\[Default Applications\][[:space:]]*$/)
    if (section) found = 1
  }
  section && /^[^#;=]+=/ {
    key = substr($0, 1, index($0, "=") - 1)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    if (key in defaults) {
      if (!written[key]++) print key "=" defaults[key]
      next
    }
  }
  { print }
  END {
    if (!found) print "\n[Default Applications]"
    remaining()
  }
' "$temporary/defaults" "$existing" >"$temporary/mimeapps.list"
chmod 600 "$temporary/mimeapps.list"

if [[ -e $target || -L $target ]]; then
  backup=$target.before-gentoo-$$
  if [[ -e $backup || -L $backup ]]; then
    echo 'MIME backup already exists' >&2
    exit 1
  fi
  mv -T -- "$target" "$backup"
fi

mv -T -- "$temporary/mimeapps.list" "$target"

xdg-settings set default-web-browser "$browser"

for mime in x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml; do
  if [[ $(xdg-mime query default "$mime") != "$browser" ]]; then
    echo "MIME default verification failed for $mime" >&2
    exit 1
  fi
done

echo 'Browser and MIME defaults verified'
