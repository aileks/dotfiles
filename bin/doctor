#!/usr/bin/env bash

set -uo pipefail

failures=0
desktop_active=0
ok_color=""
warn_color=""
out_reset=""
error_color=""
err_reset=""

if [[ ! -v NO_COLOR && -t 1 ]]; then
	ok_color=$'\e[32m'
	warn_color=$'\e[33m'
	out_reset=$'\e[0m'
fi
if [[ ! -v NO_COLOR && -t 2 ]]; then
	error_color=$'\e[31m'
	err_reset=$'\e[0m'
fi

pass() { printf '%s[ok]%s %s\n' "$ok_color" "$out_reset" "$*"; }
warn() { printf '%s[warn]%s %s\n' "$warn_color" "$out_reset" "$*"; }
fail() {
	printf '%s[fail]%s %s\n' "$error_color" "$err_reset" "$*" >&2
	failures=$((failures + 1))
}
error() { printf '%s[error]%s %s\n' "$error_color" "$err_reset" "$*" >&2; }

[[ $# == 0 ]] || {
	error 'doctor takes no arguments'
	exit 2
}

deploy_lib="${DOTFILES_DIR:-$HOME/.dotfiles}/lib/deploy.sh"
if [[ -r $deploy_lib ]]; then
	# shellcheck source=lib/deploy.sh
	source "$deploy_lib"
else
	error "missing $deploy_lib; run setup.sh first"
	exit 2
fi

if [[ ${XDG_CURRENT_DESKTOP:-} == *Hyprland* ]] && command -v hyprctl >/dev/null; then
	desktop_active=1
fi

check_command() {
	if command -v "$1" >/dev/null; then
		pass "$1 installed"
	else
		fail "$1 missing"
	fi
}

check_package() {
	if pacman -Qq "$1" >/dev/null 2>&1; then
		pass "$1 installed"
	else
		fail "$1 missing"
	fi
}

check_enabled() {
	if systemctl is-enabled --quiet "$1"; then
		pass "$1 enabled"
	else
		fail "$1 disabled"
	fi
}

check_user_enabled() {
	if systemctl --user is-enabled --quiet "$1"; then
		pass "$1 enabled"
	else
		fail "$1 disabled"
	fi
}

check_user_active() {
	if systemctl --user is-active --quiet "$1"; then
		pass "$1 active"
	else
		fail "$1 inactive"
	fi
}

check_link() {
	local target=$1 source=$2
	if [[ -L $target && $(readlink "$target") == "$source" ]]; then
		pass "$target linked to dotfiles"
	else
		fail "$target is not linked to $source"
	fi
}

check_bat_theme() {
	if bat --list-themes 2>/dev/null | grep -Fxq cinder-grove; then
		pass 'Bat cinder-grove theme available'
	else
		fail 'Bat cinder-grove theme unavailable; rebuild the Bat cache'
	fi
}

nvidia_drm_active() {
	local card connector driver
	for card in /sys/class/drm/card[0-9]*; do
		[[ -e $card ]] || continue
		driver=$(basename "$(readlink -f "$card/device/driver" 2>/dev/null)")
		[[ $driver == nvidia ]] || continue
		for connector in "$card"-*; do
			[[ -e $connector ]] && return 0
		done
	done
	return 1
}

check_nvidia_modeset() {
	local parameter=/sys/module/nvidia_drm/parameters/modeset
	if [[ -r $parameter ]]; then
		if [[ $(<"$parameter") == Y ]]; then
			pass 'Nvidia DRM modesetting enabled'
		else
			fail 'Nvidia DRM modesetting disabled'
		fi
	elif [[ -e $parameter ]] && nvidia_drm_active; then
		pass 'Nvidia DRM modesetting active'
	elif ((!desktop_active)); then
		warn 'Nvidia module loads after reboot'
	else
		warn 'Nvidia DRM modesetting could not be verified'
	fi
}

check_nvidia_suspend() {
	local parameters=/proc/driver/nvidia/params
	if [[ -r $parameters ]]; then
		if grep -Eq '^PreserveVideoMemoryAllocations:[[:space:]]+1$' "$parameters"; then
			pass 'Nvidia suspend memory preservation enabled'
		else
			fail 'Nvidia suspend memory preservation disabled'
		fi
	elif ((!desktop_active)); then
		warn 'Nvidia suspend parameters load after reboot'
	else
		fail 'Nvidia suspend parameters unavailable'
	fi
}

check_system() {
	local dotfiles="${DOTFILES_DIR:-$HOME/.dotfiles}"
	local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"

	check_command omarchy
	check_command ddcutil
	check_command papirus-folders-cg
	check_package papirus-icon-theme
	if [[ $(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null) == "'Papirus-Dark'" ]]; then
		pass 'Papirus-Dark icon theme selected'
	else
		fail 'Papirus-Dark icon theme not selected'
	fi

	check_link "$config_home/hypr" "$dotfiles/hypr"
	check_link "$config_home/omarchy/shell.toml" "$dotfiles/omarchy/shell.toml"
	check_link "$config_home/omarchy/shell.json" "$dotfiles/omarchy/shell.json"
	check_link "$config_home/omarchy/themes/cinder-grove" "$dotfiles/omarchy/themes/cinder-grove"
	if [[ -d $dotfiles/omarchy/themes/cinder-grove ]]; then
		pass 'Omarchy cinder-grove theme present'
	else
		fail 'Omarchy cinder-grove theme missing'
	fi
	if [[ $(readlink "$HOME/.local/state/omarchy/current/background" 2>/dev/null) == *fantasy-woods.jpg ]]; then
		pass 'fantasy-woods wallpaper active'
	else
		fail 'fantasy-woods wallpaper not active'
	fi
	if grep -Fxq 'base-size = 14' "$config_home/omarchy/shell.toml" 2>/dev/null; then
		pass 'bar font pinned to 14'
	else
		fail 'bar font is not pinned to 14'
	fi

	if user_in_group "$USER" i2c; then
		pass "$USER is in the i2c group"
	else
		fail "$USER is missing from the i2c group"
	fi
	if grep -Eq "$MDNS_HOSTS_REGEX" /etc/nsswitch.conf; then
		pass 'mDNS hostname resolution configured'
	else
		fail 'mDNS hostname resolution missing'
	fi
	for file in "${ENABLED_SYSTEM_UNITS[@]}"; do
		check_enabled "$file"
	done
	check_user_enabled udiskie.service

	check_bat_theme
	check_nvidia_modeset
	check_nvidia_suspend
}

check_session() {
	local errors keybindings main_count monitors side_count workspaces
	if [[ ${XDG_CURRENT_DESKTOP:-} == *Hyprland* ]]; then
		pass 'Hyprland desktop environment exported'
	else
		fail 'XDG_CURRENT_DESKTOP is not Hyprland'
	fi
	if systemctl --user is-active --quiet graphical-session.target; then
		pass 'graphical-session.target active'
	else
		fail 'graphical-session.target inactive'
	fi
	check_user_active udiskie.service
	check_user_active pipewire.service
	check_user_active pipewire-pulse.service
	check_user_active wireplumber.service

	errors=$(hyprctl configerrors 2>/dev/null || true)
	if [[ -z $errors ]]; then
		pass 'Hyprland config has no errors'
	else
		fail "Hyprland config errors: $errors"
	fi

	# The menu pads output columns, hence the loose regexes.
	keybindings=$(omarchy menu keybindings --print 2>/dev/null || true)
	if grep -Eq '^SUPER \+ h[[:space:]].*Focus' <<<"$keybindings"; then
		pass 'hjkl focus bindings present'
	else
		fail 'hjkl focus bindings missing'
	fi
	if grep -Eq '^SUPER SHIFT \+ h[[:space:]].*Swap window' <<<"$keybindings"; then
		pass 'hjkl swap bindings present'
	else
		fail 'hjkl swap bindings missing'
	fi
	if grep -Eq 'SUPER \+ LEFT .*Focus on left' <<<"$keybindings"; then
		fail 'Omarchy arrow focus bindings still present'
	else
		pass 'arrow navigation replaced by hjkl'
	fi
	if grep -Eq 'SUPER \+ 9|SUPER \+ code:18' <<<"$keybindings"; then
		fail 'workspace 9/0 bindings still present'
	else
		pass 'exactly eight workspaces bound'
	fi

	if monitors=$(hyprctl -j monitors 2>/dev/null); then
		main_count=$(jq '[.[] | select(.name == "DP-1" and .x == 0 and .y == 0 and .refreshRate >= 199)] | length' <<<"$monitors")
		side_count=$(jq '[.[] | select(.name == "HDMI-A-1" and .x == -1080 and .y == 0 and .transform == 1 and .refreshRate >= 199)] | length' <<<"$monitors")
		if ((main_count == 1)); then
			pass 'main monitor geometry correct'
		else
			fail 'main monitor geometry incorrect'
		fi
		if ((side_count == 1)); then
			pass 'portrait monitor geometry correct'
		else
			fail 'portrait monitor geometry incorrect'
		fi
	else
		fail 'could not query Hyprland monitors'
	fi
	if workspaces=$(hyprctl -j workspaces 2>/dev/null); then
		main_count=$(jq '[.[] | select(.monitor == "DP-1") | .name] | length' <<<"$workspaces")
		side_count=$(jq '[.[] | select(.monitor == "HDMI-A-1") | .name] | length' <<<"$workspaces")
		if ((main_count == 7 && side_count == 1)); then
			pass 'workspaces pinned to monitors (7 + 1)'
		else
			fail "unexpected workspace distribution: $main_count on DP-1, $side_count on HDMI-A-1"
		fi
	else
		fail 'could not query Hyprland workspaces'
	fi

	if wpctl status >/dev/null 2>&1; then
		pass 'PipeWire responds'
	else
		fail 'PipeWire unavailable'
	fi
	if busctl --user --list 2>/dev/null | grep -q org.freedesktop.secrets; then
		pass 'Secret Service available'
	else
		warn 'Secret Service has not been activated; first use will request keyring unlock'
	fi
}

check_system
if ((desktop_active)); then
	check_session
else
	warn 'Hyprland session checks skipped'
fi

((failures == 0))
