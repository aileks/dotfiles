#!/usr/bin/env bash

set -euo pipefail

if [[ ${1:-} == supervise ]]; then
  shift
  # setsid gives this supervisor its own process group. Children of launchers
  # (including PipeWire and clipboard watchers) share that group's lifetime.
  # shellcheck disable=SC2329 # Invoked by the EXIT trap.
  finish() {
    trap - EXIT
    trap '' TERM INT HUP
    kill -TERM -- "-$$" 2>/dev/null || true
    sleep 1
    kill -KILL -- "-$$" 2>/dev/null || true
  }
  trap finish EXIT
  trap 'exit 0' TERM INT HUP
  "$@" &
  wait "$!"
  exit
fi

# shellcheck source=config/session/processes.sh
source "${XDG_CONFIG_HOME:-$HOME/.config}/session/processes.sh"
case ${1:-} in
  start)
    shift
    start_session_process "$@"
    ;;
  stop) stop_session_process "${2:?process name required}" ;;
  status) record_is_live "$RUNTIME_DIR/${2:?process name required}.pid" ;;
  *)
    echo 'Usage: session-process start NAME COMMAND... | stop NAME | status NAME' >&2
    exit 2
    ;;
esac
