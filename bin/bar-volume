#!/usr/bin/env bash

case ${BLOCK_BUTTON:-} in
  1) audio sink mute ;;
  4) audio sink up ;;
  5) audio sink down ;;
esac

volume=$(wpctl get-volume '@DEFAULT_AUDIO_SINK@' 2>/dev/null) || {
  printf '^c#58534C^n/a^d^\n'
  exit 0
}

if [[ $volume == *[MUTED]* ]]; then
  printf '^c#B34A45^%s mute^d^\n' ''
  exit 0
fi

percent=$(awk '{ printf "%.0f", $2 * 100 }' <<<"$volume")
printf '^c#58534C^%s %s%%^d^\n' '' "$percent"
