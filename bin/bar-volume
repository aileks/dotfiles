#!/usr/bin/env bash

volume_icon=$'\uF028'
muted_icon=$'\uF0581'

[[ ${BLOCK_BUTTON:-} == 1 ]] && wpctl set-mute '@DEFAULT_AUDIO_SINK@' toggle >/dev/null 2>&1

volume=$(wpctl get-volume '@DEFAULT_AUDIO_SINK@' 2>/dev/null) || {
  printf 'n/a\n'
  exit 0
}

if [[ $volume == *[MUTED]* ]]; then
  printf '%s  mute\n' "$muted_icon"
  exit 0
fi

percent=$(awk '{ printf "%.0f", $2 * 100 }' <<<"$volume")
printf '%s %s%%\n' "$volume_icon" "$percent"
