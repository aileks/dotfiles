#!/usr/bin/env bash

set -Eeuo pipefail

readonly unit=desktop-nightlight.service

refresh_waybar() {
  pkill -RTMIN+8 -x waybar 2>/dev/null || true
}

is_active() {
  systemctl --user is-active --quiet "$unit"
}

case "${1:-toggle}" in
  on)
    if systemctl --user start "$unit"; then
      refresh_waybar
      notify-send -a 'Night Light' 'Night Light enabled' 'Color temperature: 4000 K'
    else
      notify-send -u critical -a 'Night Light' 'Could not enable Night Light'
      exit 1
    fi
    ;;
  off)
    if systemctl --user stop "$unit"; then
      refresh_waybar
      notify-send -a 'Night Light' 'Night Light disabled'
    else
      notify-send -u critical -a 'Night Light' 'Could not disable Night Light'
      exit 1
    fi
    ;;
  toggle)
    if is_active; then
      exec "$0" off
    else
      exec "$0" on
    fi
    ;;
  status)
    if is_active; then
      printf 'on\n'
    else
      printf 'off\n'
      exit 1
    fi
    ;;
  *)
    printf 'usage: desktop-nightlight [on|off|toggle|status]\n' >&2
    exit 2
    ;;
esac
