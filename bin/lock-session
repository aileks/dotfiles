#!/usr/bin/env bash

set -Eeuo pipefail

runtime_directory=${XDG_RUNTIME_DIR:?}
[[ -d $runtime_directory && -O $runtime_directory ]] || exit 1
umask 077
exec 9>"$runtime_directory/lock-session.lock"
flock -w 5 9 || exit 1

ready_file="$runtime_directory/lock-session.ready"
if [[ -f $ready_file ]]; then
  read -r pid start_time <"$ready_file" || true
  if [[ ${pid:-} =~ ^[0-9]+$ && ${start_time:-} =~ ^[0-9]+$ ]] \
    && read -r state current_start < <(awk '{ print $3, $22 }' "/proc/$pid/stat" 2>/dev/null) \
    && [[ $state != Z && $current_start == "$start_time" ]]; then
    exit 0
  fi
fi
rm -f -- "$ready_file"

i3lock -c 131210 \
  --ring-color=879b5cff \
  --insidever-color=131210ff \
  --insidewrong-color=b34a45ff \
  --ringver-color=e17a3fff \
  --ringwrong-color=b34a45ff \
  --verif-text='' --wrong-text='' --noinput-text='' 9>&- || exit 1
pid=$(pgrep -n -u "$UID" -x i3lock) || exit 1
start_time=$(awk '{ print $22 }' "/proc/$pid/stat") || exit 1
printf '%s %s\n' "$pid" "$start_time" >"$ready_file"
