#!/usr/bin/env bash

set -euo pipefail

# Serialize idle, sleep and keybinding requests. swaylock -f returns only once
# the lock is established, allowing the caller to suspend safely.
exec 9>"${XDG_RUNTIME_DIR:?}/lock-session.lock"
flock 9
pgrep -u "$(id -u)" -x swaylock >/dev/null && exit 0
swaylock -f 9>&-
