[global]
dmenu = rofi -dmenu -i -p Notifications
follow = none
width = 380
height = (0, 120)
origin = top-right
offset = (0, 25)
frame_width = 2
frame_color = "#624F46"
separator_color = frame
font = Iosevka Nerd Font 12
icon_position = left
icon_theme = Papirus-Dark
max_icon_size = 32
gap_size = 6
padding = 10
horizontal_padding = 12
text_icon_padding = 10
corner_radius = 0
format = "<b>%s</b>\n%b"
timeout = 5

[urgency_low]
background = "#16110F"
foreground = "#C9AEA0"
frame_color = "#624F46"
timeout = 4

[urgency_normal]
background = "#16110F"
foreground = "#C9AEA0"
frame_color = "#A78E82"
timeout = 5

[urgency_critical]
background = "#16110F"
foreground = "#ECCFC1"
frame_color = "#A45751"
timeout = 0
