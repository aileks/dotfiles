// Waybar 0.15.0: ext/workspaces is included; mango/* is not.
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "on-sigusr1": "toggle",
  "modules-left": ["ext/workspaces"],
  "modules-center": ["mpris"],
  "modules-right": ["cpu", "temperature", "memory", "network", "pulseaudio", "tray", "clock"],
  "ext/workspaces": {
    "format": "{name}",
    "all-outputs": false,
    "active-only": false,
    "ignore-hidden": false,
    "sort-by-name": true,
    "on-click": "activate",
    // Mango maps the native deactivate request to toggling a tag.
    "on-click-right": "deactivate"
  },
  "mpris": {
    "player": "playerctld",
    "format": "{dynamic}",
    "format-paused": "Paused: {dynamic}",
    "format-stopped": "",
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 48,
    "max-length": 48,
    "tooltip-format": "{player} ({status})\n{artist}\n{title}\n{album}\n{length}",
    "enable-tooltip-len-limits": false
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 3,
    "on-click": "wezterm start --always-new-process -- btop"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "format": "{temperatureC}°C",
    "tooltip-format": "CPU Tctl: {temperatureC}°C",
    "interval": 3,
    "on-click": "wezterm start --always-new-process -- btop"
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 3,
    "on-click": "wezterm start --always-new-process -- btop"
  },
  "network": {
    "format-ethernet": "{ifname}",
    "format-wifi": "{essid}",
    "format-disconnected": "Offline",
    "max-length": 16,
    "tooltip-format": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes} ↑ {bandwidthUpBytes}",
    "on-click": "wezterm start --always-new-process -- nmtui"
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "wezterm start --always-new-process -- wiremix",
    "on-click-right": "swayosd-client --output-volume mute-toggle",
    "on-click-middle": "swayosd-client --input-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume +5 --max-volume 100",
    "on-scroll-down": "swayosd-client --output-volume -5 --max-volume 100"
  },
  "tray": { "icon-size": 18, "spacing": 6 },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "format-alt": "{:%a %d %b %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
