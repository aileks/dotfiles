# Shell Integrations
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

if command -v fzf >/dev/null 2>&1; then
  eval "$(command fzf --bash)"
fi

if [[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/shell-integration.sh ]]; then
  # shellcheck source=config/wezterm/shell-integration.sh
  source "${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/shell-integration.sh"
fi

# Prompt
make_prompt() {
  local status=$1

  local reset=$'\e[0m'
  local bold=$'\e[1m'

  local orange=$'\e[38;2;225;122;63m'
  local blue=$'\e[38;2;103;133;161m'
  local magenta=$'\e[38;2;154;120;143m'
  local muted=$'\e[38;2;154;147;138m'
  local red=$'\e[38;2;179;74;69m'
  local cyan=$'\e[38;2;88;145;140m'

  local git_segment=''
  local status_segment=''
  local branch=''

  if branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null); then
    git_segment=" \[${magenta}\] ${branch}\[${reset}\]"
  fi

  if ((status != 0)); then
    status_segment=" \[${red}\] ${status}\[${reset}\]"
  fi

  PS1="\[${orange}${bold}\]\W\[${reset}\]"
  PS1+=" \[${muted}\]• \[${blue}\]\h\[${reset}\]"
  PS1+="${git_segment}${status_segment}"
  PS1+='\n'
  PS1+="\[${cyan}${bold}\]❯\[${reset}\] "
}

_prompt_command() {
  local status=$?
  history -a
  history -n
  make_prompt "$status"
}

_install_prompt_command() {
  local -a previous=()
  local command

  if declare -p PROMPT_COMMAND &>/dev/null; then
    if [[ $(declare -p PROMPT_COMMAND) == "declare -a"* ]]; then
      previous=("${PROMPT_COMMAND[@]}")
    elif [[ -n ${PROMPT_COMMAND:-} ]]; then
      previous=("$PROMPT_COMMAND")
    fi
  fi

  PROMPT_COMMAND=(_prompt_command)

  for command in "${previous[@]}"; do
    [[ $command == _prompt_command ]] || PROMPT_COMMAND+=("$command")
  done
}

_install_prompt_command
unset -f _install_prompt_command
