# Yazi
y() {
  local cwd_file cwd result

  cwd_file=$(mktemp -t yazi-cwd.XXXXXX) || return

  command yazi "$@" --cwd-file="$cwd_file"
  result=$?

  cwd=$(<"$cwd_file")
  command rm -f -- "$cwd_file"

  if [[ -n $cwd && $cwd != "$PWD" ]]; then
    builtin cd -- "$cwd" || return
  fi

  return "$result"
}

