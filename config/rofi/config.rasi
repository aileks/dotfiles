/*
 * Cinder Grove theme shared by the drun launcher and every -dmenu script.
 * Every element state is set explicitly so the default theme cannot leak
 * through; the 93% alphas mirror the old wmenu wrappers.
 */

configuration {
    matching: "normal";
    show-icons: false;
    drun-display-format: "{name}";
}

* {
    background-color: rgba ( 19, 18, 16, 93% );
    text-color:       rgba ( 187, 179, 169, 100% );
    font:             "Iosevka Nerd Font 16";
}

window {
    location:         center;
    width:            720px;
    padding:          10px;
    background-color: rgba ( 19, 18, 16, 93% );
    border:           2px;
    border-color:     rgba ( 103, 133, 161, 93% );
}

mainbox {
    spacing:  8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: rgba ( 103, 133, 161, 93% );
    text-color:       rgba ( 19, 18, 16, 100% );
    padding:          6px 10px;
    spacing:          8px;
    children:         [ prompt , entry ];
}

prompt {
    background-color: transparent;
    text-color:       rgba ( 19, 18, 16, 100% );
}

entry {
    background-color:  transparent;
    text-color:        rgba ( 19, 18, 16, 100% );
    placeholder:       "Type to filter";
    placeholder-color: rgba ( 19, 18, 16, 60% );
}

listview {
    lines:        8;
    fixed-height: false;
    spacing:      2px;
    scrollbar:    false;
    border:       0;
}

element {
    padding: 2px 6px;
}

element normal.normal    { background-color: transparent; text-color: rgba ( 187, 179, 169, 100% ); }
element normal.urgent    { background-color: transparent; text-color: rgba ( 103, 133, 161, 100% ); }
element normal.active    { background-color: transparent; text-color: rgba ( 187, 179, 169, 100% ); }
element alternate.normal { background-color: transparent; text-color: rgba ( 187, 179, 169, 100% ); }
element alternate.urgent { background-color: transparent; text-color: rgba ( 103, 133, 161, 100% ); }
element alternate.active { background-color: transparent; text-color: rgba ( 187, 179, 169, 100% ); }

element selected.normal { background-color: rgba ( 103, 133, 161, 93% ); text-color: rgba ( 19, 18, 16, 100% ); }
element selected.urgent { background-color: rgba ( 103, 133, 161, 93% ); text-color: rgba ( 19, 18, 16, 100% ); }
element selected.active { background-color: rgba ( 103, 133, 161, 93% ); text-color: rgba ( 19, 18, 16, 100% ); }

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             1em;
}
