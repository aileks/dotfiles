# Template file for 'helium'
pkgname=helium
version=0.17.2.1
revision=1
archs="x86_64"
create_wrksrc=yes
depends="gtk+3 nss"
short_desc="Private, fast, and honest web browser based on Chromium"
maintainer="Kieran Pedrick <kieran@aileks.dev>"
license="GPL-3.0-or-later"
homepage="https://helium.computer"
distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
checksum=2a639df54e3d05f413cfbb4622a4d1a68584b31da5a7aaf58ee3cd83c7c3e299

do_install() {
	vmkdir usr/lib/helium
	cp -a "helium-${version}-x86_64_linux/." "${DESTDIR}/usr/lib/helium/"
	rm -f "${DESTDIR}/usr/lib/helium/helium.desktop" "${DESTDIR}/usr/lib/helium/product_logo_256.png"
	vmkdir usr/bin
	ln -s /usr/lib/helium/helium "${DESTDIR}/usr/bin/helium"
	vinstall "helium-${version}-x86_64_linux/helium.desktop" 644 usr/share/applications
	vinstall "helium-${version}-x86_64_linux/product_logo_256.png" 644 usr/share/icons/hicolor/256x256/apps/helium.png
}
