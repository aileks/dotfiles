# Template file for 'zen-browser'
pkgname=zen-browser
version=1.22.2b
revision=1
archs="x86_64"
create_wrksrc=yes
depends="gtk+3 nss"
short_desc="Firefox based browser with a focus on privacy and customization"
maintainer="Kieran Pedrick <kieran@aileks.dev>"
license="MPL-2.0"
homepage="https://zen-browser.app"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz"
checksum=163823cf56b068e81bb8a48d93c9dbda3993f54f03f8d37e684e380bfc11b892

do_install() {
	vmkdir usr/lib/zen-browser
	cp -a zen/. "${DESTDIR}/usr/lib/zen-browser/"
	vmkdir usr/bin
	ln -s /usr/lib/zen-browser/zen "${DESTDIR}/usr/bin/zen-browser"
	vinstall ${FILESDIR}/zen.desktop 644 usr/share/applications
	vinstall zen/browser/chrome/icons/default/default128.png 644 usr/share/icons/hicolor/128x128/apps/zen-browser.png
}
